# ==========================================================================
# WhatsApp AI Kit — environment. Copy to .env and fill in. NEVER commit .env.
# Everything here works on FREE tiers.
# ==========================================================================

# ---- WhatsApp (Baileys) ----
# The bot logs a QR the first time; you scan it with the client's WhatsApp app.
# After that, creds live in AUTH_DIR and the bot reconnects automatically.
AUTH_DIR=./auth_state
# Where the bot stores conversations/leads: "local" (JSON file) or "supabase".
STORAGE=local
# Only reply to these country codes' numbers (comma separated), e.g. 91 for India.
ALLOWED_COUNTRY_CODES=91
# Ignore group chats entirely (recommended).
IGNORE_GROUPS=true

# ---- AI (Groq free tier by default; OpenAI-compatible) ----
# Get a free key at https://console.groq.com/keys
AI_PROVIDER=groq
AI_API_KEY=gsk_replace_me
AI_BASE_URL=https://api.groq.com/openai/v1
# Free-plan model (Groq free tier, no card). Llama models moved to Enterprise-only.
AI_MODEL=openai/gpt-oss-120b
# Use a local model instead (if you run Ollama): set AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=ollama
# AI_MODEL=llama3.1

# ---- Supabase (only needed when STORAGE=supabase) ----
# Create a free project at https://supabase.com then paste keys.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Google Sheets lead sink (optional; easiest for clients to see) ----
# Paste the Web App URL from the Apps Script in docs/apps-script/Code.gs.
GOOGLE_SHEET_WEBHOOK_URL=
# Shared secret you set in the same Apps Script.
GOOGLE_SHEET_SECRET=change-me

# ---- Which client config to load (config/<name>.json) ----
CLIENT=client

# ---- Public site (apps/public) — no secrets ----
# Static marketing site. Holds NO Supabase key and NO secret of any kind.
# Absolute origin used for canonical/OG/sitemap URLs (set the deployed origin in prod).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Admin app (apps/admin) — server-side only ----
# The admin reads/writes Supabase with the service-role key, server-side only.
# NEVER prefix these two with NEXT_PUBLIC_ (they must never reach the browser).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Secret-path gate. Until you open https://<admin-host>/enter?key=<ADMIN_KEY> once,
# the admin returns a byte-identical 404 to every path and method.
# Generate: openssl rand -hex 24  (ADMIN_KEY)   openssl rand -hex 32  (ADMIN_SESSION_SECRET)
ADMIN_KEY=
ADMIN_SESSION_SECRET=
# Payment page (admin /pay) — the business's own UPI details.
NEXT_PUBLIC_UPI_ID=
NEXT_PUBLIC_UPI_NAME=

# ---- Push notifications (optional; free) ----
# Generate once: npx web-push generate-vapid-keys
# Admin client needs the PUBLIC key (it is embedded in the browser; that is expected):
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Bot sender (server-only; needs both keys + the subject; VAPID_SUBJECT is a mailto: or URL):
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Hours of contact silence before a handed-off chat auto-resumes.
HANDOFF_IDLE_HOURS=24

# ---- Misc ----
TZ=Asia/Kolkata
LOG_LEVEL=info
